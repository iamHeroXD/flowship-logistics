# Flowship Logistics Environment Configuration

# Server & Database
NODE_ENV=development
PORT=3000
DATABASE_URL=file:./data/flowship.json
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=7d

# Payment Gateways (Leave empty or provide test keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Maps & Geocoding
NEXT_PUBLIC_MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Notifications
EMAIL_PROVIDER=console
SENDGRID_API_KEY=
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
